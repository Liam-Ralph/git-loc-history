# Maintainer: Liam Ralph <liamralph@tutamail.com>
pkgname=git-loc-history
pkgver=1.0.0
pkgrel=1
pkgdesc="An application for viewing a git repo's lines of code across its history."
arch=(x86_64)
url="https://github.com/liam-ralph/git-loc-history"
license=("MIT")
depends=("qt6-base>=6.5" "qt6-charts>=6.5")
makedepends=(cmake)
conflicts=(git-loc-history-bin)
source=(
    "https://github.com/liam-ralph/git-loc-history/refs/tags/v${pkgver}.tar.gz"
    "https://github.com/libgit2/libgit2/archive/refs/tags/v1.9.6.tar.gz"
)
sha256sums=(
    ""
    "a88a42a4ea9bdab7aa8686eead3bf7d9c6dd74529caca16ab22eaa92433d31d9"
)

build() {
    mv libgit2-1.9.6 $pkgname-$pkgver
    cd $pkgname-$pkgver
    sed -i -e "s/#define ABSOLUTE_PATHS false/#define ABSOLUTE_PATHS true/g" src/definitions.cpp
    sed -i -e "s//W4//w/g" CMakeLists.txt
    sed -i -e "s/-Wall -Wextra -Wpendantic/-Wno/g" CMakeLists.txt
    mkdir build
    cd build
    cmake ..
    cmake --build . --parallel $(nproc) --config Release
    strip git-loc-history git-loc-history-cli
}

package() {
    cd $pkgname-$pkgver
    install -Dm755 build/git-loc-history $pkgdir/usr/bin/git-loc-history
    install -Dm755 build/git-loc-history-cli $pkgdir/usr/bin/git-loc-history-cli
    install -Dm644 pkg/resources/git-loc-history.desktop \
        $pkgdir/usr/share/applications/git-loc-history.desktop
    install -Dm644 pkg/resources/copyright $pkgdir/usr/share/doc/git-loc-history/copyright
    install -Dm644 README.md $pkgdir/usr/share/doc/git-loc-history/README.md
    install -Dm644 CHANGELOG.md $pkgdir/usr/share/doc/git-loc-history/CHANGELOG.md
    install -Dm644 logo.png $pkgdir/usr/share/icons/hicolor/512x512/git-loc-history.png
    install -Dm644 LICENSE $pkgdir/usr/share/licenses/git-loc-history/LICENSE
}
