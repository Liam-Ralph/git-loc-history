# Maintainer: Liam Ralph <liamralph@tutamail.com>
pkgname=git-loc-history
pkgver=VERSION
pkgrel=1
pkgdesc="An application for viewing a git repo's lines of code across its history."
arch=(x86_64)
url="https://github.com/liam-ralph/git-loc-history"
license=("MIT")
depends=("qt6-base>=6.11" "qt6-charts>=6.11")
source=("$pkgname-$pkgver.tar.gz")
sha256sums=("SHA256SUM")

package() {
    cd $pkgname-$pkgver
    install -Dm755 usr/bin/git-loc-history "$pkgdir/usr/bin/git-loc-history"
    install -Dm755 usr/bin/git-loc-history-cli "$pkgdir/usr/bin/git-loc-history-cli"
    install -Dm644 usr/share/git-loc-history/defaults.conf \
        "$pkgdir/usr/share/git-loc-history/defaults.conf"
    install -Dm644 usr/share/applications/git-loc-history.desktop \
        "$pkgdir/usr/share/applications/git-loc-history.desktop"
    install -Dm644 usr/share/doc/git-loc-history/copyright \
        "$pkgdir/usr/share/doc/git-loc-history/copyright"
    install -Dm644 usr/share/doc/git-loc-history/README.md \
        "$pkgdir/usr/share/doc/git-loc-history/README.md"
    install -Dm644 usr/share/doc/git-loc-history/CHANGELOG.md \
        "$pkgdir/usr/share/doc/git-loc-history/CHANGELOG.md"
    install -Dm644 usr/share/icons/hicolor/512x512/apps/git-loc-history.png \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/git-loc-history.png"
    install -Dm644 usr/share/licenses/git-loc-history/LICENSE \
        "$pkgdir/usr/share/licenses/git-loc-history/LICENSE"
}

post_remove() {
    if [[ -n $XDG_CONFIG_DIR && ! -z $XDG_CONFIG_DIR ]]; then
        rm -rf "$XDG_CONFIG_DIR/git-loc-history.conf"
    else
        rm -rf /home/*/.config/git-loc-history.conf
    fi
    rm -rf /var/cache/git-loc-history
}
